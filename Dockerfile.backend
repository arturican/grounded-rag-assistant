FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.115,<1.0" \
    "httpx>=0.28,<1.0" \
    "pydantic>=2.0,<3.0" \
    "uvicorn>=0.32,<1.0"

COPY backend ./backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.app.api:app", "--host", "0.0.0.0", "--port", "8000"]
